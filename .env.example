# ============================================
# 电子女友 配置  ·  示例（复制为 .env 使用）
# 从 setup.html 生成后放到项目根目录即可
# ============================================

# ----- 基础 -----
APP_NAME=电子女友
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/pimate.db

# ----- 大模型（OpenAI 兼容）-----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的密钥
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=45
HISTORY_LIMIT=16
RATE_LIMIT_PER_MINUTE=30

# ----- 语音（推荐阿里百炼 qwen3-tts-flash）-----
SPEECH_BACKEND=dashscope
DASHSCOPE_API_KEY=
ASR_MODEL=
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
# 备用号QQ语音回复概率（0~1）：回复时偶尔发一条语音
VOICE_REPLY_PROB=0.25

# ----- 图片/视频识别（阿里百炼 qwen-vl-max）-----
VISION_MODEL=qwen-vl-max
# 视频链接解析的 cookie 文件（Netscape 格式，抖音等需要登录态的站点必填）
# 用浏览器扩展"Get cookies.txt LOCALLY"导出抖音的 cookies 后填路径，例如 data/douyin_cookies.txt
VIDEO_COOKIES_FILE=

# ----- 记忆遗忘曲线 -----
MEMORY_THRESHOLD=0.3
MEMORY_HALF_LIFE_DAYS=7

# ----- 安全控制（留空=不限）-----
ALLOWLIST=

# ----- QQ 官方机器人 -----
QQ_ENABLED=false
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_SANDBOX=false
QQ_INTENTS=33554432

# ----- OneBot 11（QQ）-----
ONEBOT_ENABLED=false
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# ----- 微信公众号 -----
WECHAT_TOKEN=
WECHAT_REPLY_TIMEOUT_SECONDS=4.5

# ----- 微信网关 -----
WECHAT_GATEWAY_ENABLED=false
WECHAT_GATEWAY_OUTBOUND_URL=
WECHAT_GATEWAY_SECRET=

# ----- 主动问候 -----
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_MINUTES=120
PROACTIVE_QUIET_START=23
PROACTIVE_QUIET_END=8

# ----- 活人感（回答随机化） -----
# 回复偶尔补颜文字的概率（0~1）
KAOMOJI_PROB=0.30

# ----- 人设文件 -----
PERSONA_PATH=personas/youzi.yaml

STICKER_PROB=0.12
STICKER_GIF_PROB=0.70
STICKER_COOLDOWN_MIN=15
